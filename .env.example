# =====================================================================
# Antigravity (agy) Telegram Bot Bridge Configuration
# =====================================================================

# 1. Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# 2. Allowed Telegram User IDs (comma-separated, obtain from @userinfobot)
# REQUIRED FOR SECURITY: Only these users will be permitted to run commands.
ALLOWED_USER_IDS="123456789,987654321"

# 3. agy Executable Path (optional, defaults to `which agy` or /home/pete/.local/bin/agy)
AGY_BIN="/home/pete/.local/bin/agy"

# 4. Default Working Directory (optional, defaults to current directory)
DEFAULT_WORKING_DIR="/home/pete/share/code/agy_bot"

# 5. Default Model (e.g. gemini-3.7-flash-high, claude-sonnet-4-6, etc.)
DEFAULT_MODEL="gemini-3.7-flash-high"

# 6. Default Reasoning Effort (low, medium, high)
DEFAULT_EFFORT="high"

# 7. Default Execution Mode (accept-edits, plan)
DEFAULT_MODE="accept-edits"

# 8. Auto-Approve Tool Permissions (true = --dangerously-skip-permissions)
DEFAULT_AUTO_APPROVE="true"

# 9. Live Streaming Preview in Telegram (true/false)
STREAM_LIVE_PREVIEW="true"
